# AUREVA Full-Stack Architecture — Root Environment Overview
# Individual environments are configured in client/ and server/:

# Frontend (client/.env):
# VITE_API_URL=http://localhost:5000/api

# Backend (server/.env):
# PORT=5000
# CLIENT_URL=http://localhost:5173
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aureva_db?schema=public
# JWT_SECRET=your_super_secret_jwt_key
# COOKIE_SECRET=your_super_secret_cookie_key
