{
  "name": "aureva-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "AUREVA — Haute Couture E-Commerce Platform (Full-Stack Monorepo)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build:client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run prisma:generate --prefix server",
    "start": "npm run start --prefix server",
    "lint:client": "npm run lint --prefix client",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server",
    "test:db": "npm run test:db --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
