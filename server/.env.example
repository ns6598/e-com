# =============================================================================
# AUREVA Backend Environment Configuration Template
# COPY this file to .env and replace placeholders with real local secrets.
# DO NOT commit real secrets or production credentials to version control.
# =============================================================================

# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String (Prisma format)
# Syntax: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aureva_db?schema=public

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# JWT Expiration Lifetime
JWT_EXPIRES_IN=7d

# Cookie Secret for signed cookies
COOKIE_SECRET=your_super_secret_cookie_signing_key_here
